<?xml version="1.0" encoding="utf-8"?>
<data>
    <template id="report_payment_receipt_document_custom" inherit_id="account.report_payment_receipt_document" priority="99">
        <xpath expr="//table[@name='invoices']" position="attributes">
            <attribute name="t-if">o.reconciled_invoice_ids or o.reconciled_bill_ids</attribute>
        </xpath>
        <xpath expr="//table[@name='invoices']" position="inside">
            <t t-if="not any(inv.currency_id != o.currency_id and inv.currency_id != o.company_id.currency_id for inv in invoices)" t-set="otherCurrency" t-value="False"/>
        </xpath>
        <!-- El xpath NO debe filtrar por el t-field del span: odoo/odoo@19.0 incorporo
             este mismo cambio al nucleo (17/07/2026, "use payment method line name on
             payment receipt"), asi que en un nucleo actualizado el span ya no se llama
             `o.payment_method_id.name` y un xpath que lo exija no encuentra nada, lo que
             aborta la instalacion/actualizacion del modulo. El bloque tiene un unico
             span en ambas versiones del nucleo, de modo que sin el filtro el xpath
             resuelve igual antes y despues del cambio, y el atributo queda idempotente. -->
        <xpath expr="//div[@name='payment_method']//span" position="attributes">
            <attribute name="t-field">o.payment_method_line_id.name</attribute>
        </xpath>
    </template>
</data>
